PORT=5000
# Local MongoDB (default) or an Atlas string: mongodb+srv://<user>:<password>@cluster.mongodb.net/qivanta
MONGO_URI=mongodb://127.0.0.1:27017/qivanta
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173
# Optional: leave blank to skip sending emails (they are logged instead)
EMAIL_USER=
EMAIL_PASS=
# Used only by "npm run seed" to create the admin account
ADMIN_EMAIL=admin@qivanta.studio
ADMIN_PASSWORD=Admin@12345
BRAND_NAME=QIVANTA
